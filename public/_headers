# Cloudflare Pages cache rules.
# Vite's hashed bundles (JS/CSS/fonts) never change under the same name.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Game art and audio keep stable names, so cache for a day and revalidate.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
